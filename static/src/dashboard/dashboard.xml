<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="analitica_talleresg2.TallerDashboard">
        <div class="o_taller_dashboard p-4" style="height: 100%; max-height: 100%; overflow-y: auto !important; overflow-x: hidden; flex: 1 1 100%;">
            <!-- Barra Superior / Encabezado -->
            <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-3 border-bottom">
                <div>
                    <h2 class="mb-1 text-primary fw-bold d-flex align-items-center">
                        <i class="fa fa-tachometer me-2"/> Tablero de Control - Taller Automotriz
                    </h2>
                    <p class="text-muted mb-0">Métricas analíticas ejecutivas de facturación, retención de flotas y productividad</p>
                </div>
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <!-- Selector de Mes / Periodo Histórico -->
                    <div class="input-group input-group-sm shadow-sm" style="width: auto;">
                        <span class="input-group-text bg-white text-muted fw-bold border-end-0">
                            <i class="fa fa-calendar me-1 text-primary"/> Mes:
                        </span>
                        <select class="form-select form-select-sm fw-semibold text-primary border-start-0" t-on-change="onPeriodChange" style="min-width: 170px; cursor: pointer;">
                            <t t-foreach="state.data.available_months" t-as="m" t-key="m.key">
                                <option t-att-value="m.key" t-att-selected="m.selected">
                                    <t t-esc="m.nombre"/>
                                </option>
                            </t>
                        </select>
                    </div>

                    <button class="btn btn-primary btn-sm d-flex align-items-center gap-1 shadow-sm" t-on-click="() => this.loadData()">
                        <i class="fa fa-refresh" t-att-class="{'fa-spin': state.loading}"/>
                        <span>Actualizar</span>
                    </button>
                    <button class="btn btn-outline-secondary btn-sm shadow-sm" t-on-click="openInvoicesMonth">
                        <i class="fa fa-file-text-o me-1"/> Facturas del Mes
                    </button>
                    <button class="btn btn-outline-secondary btn-sm shadow-sm" t-on-click="() => this.openAllVehicles()">
                        <i class="fa fa-car me-1"/> Bitácora
                    </button>
                </div>
            </div>

            <!-- Loader cuando está cargando -->
            <t t-if="state.loading">
                <div class="text-center py-5">
                    <i class="fa fa-circle-o-notch fa-spin fa-3x text-primary mb-3"/>
                    <h5 class="text-muted">Calculando indicadores del taller...</h5>
                </div>
            </t>

            <t t-else="">
                <!-- Fila 1: Tarjetas Principales de KPI -->
                <div class="row g-3 mb-4">
                    <!-- Tarjeta 1: Facturación del Mes vs Mes Anterior -->
                    <div class="col-12 col-sm-6 col-xl">
                        <div class="card h-100 shadow-sm border-0 o_kpi_card o_kpi_blue cursor-pointer" t-on-click="openInvoicesMonth" title="Clic para ver facturas del mes">
                            <div class="card-body p-3 d-flex flex-column">
                                <div class="d-flex justify-content-between align-items-start mb-1">
                                    <div>
                                        <span class="o_kpi_title">Facturación <t t-esc="state.data.mes_actual.nombre"/></span>
                                        <div class="o_kpi_main_num"><t t-esc="state.data.mes_actual.total_fmt"/></div>
                                    </div>
                                    <div class="o_kpi_icon_wrapper" style="background: #eff6ff; color: #2563eb;">
                                        <i class="fa fa-dollar"/>
                                    </div>
                                </div>
                                <div class="o_exec_subbadge d-flex align-items-center justify-content-between">
                                    <span class="text-muted"><i class="fa fa-calculator me-1 opacity-75"/>Base Imponible</span>
                                    <span>c/IVA: <strong class="text-dark"><t t-esc="state.data.mes_actual.total_con_iva_fmt"/></strong></span>
                                </div>
                                <div class="d-flex align-items-center gap-2 mb-3">
                                    <span t-attf-class="o_trend_badge #{state.data.variacion.positiva ? 'o_trend_up' : 'o_trend_down'}">
                                        <i t-attf-class="fa #{state.data.variacion.positiva ? 'fa-arrow-up' : 'fa-arrow-down'} me-1"/>
                                        <t t-esc="state.data.variacion.pct"/>%
                                    </span>
                                    <span class="text-muted small" style="font-size: 0.76rem;">vs mes ant. (<t t-esc="state.data.mes_anterior.total_fmt"/>)</span>
                                </div>
                                <div class="d-flex align-items-center justify-content-between pt-2 border-top text-muted small mt-auto" style="font-size: 0.77rem;">
                                    <span><i class="fa fa-file-text-o me-1 text-primary"/> Facturas:</span>
                                    <span class="fw-semibold text-dark"><t t-esc="state.data.mes_actual.facturas"/> emitidas</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Tarjeta 2: Mano de Obra del Mes -->
                    <div class="col-12 col-sm-6 col-xl">
                        <div class="card h-100 shadow-sm border-0 o_kpi_card o_kpi_green cursor-pointer" t-on-click="openInvoicesMonth" title="Mano de obra producida">
                            <div class="card-body p-3 d-flex flex-column">
                                <div class="d-flex justify-content-between align-items-start mb-1">
                                    <div>
                                        <span class="o_kpi_title">Mano de Obra (Mes)</span>
                                        <div class="o_kpi_main_num" style="color: #059669;"><t t-esc="state.data.mes_actual.mo_fmt"/></div>
                                    </div>
                                    <div class="o_kpi_icon_wrapper" style="background: #ecfdf5; color: #059669;">
                                        <i class="fa fa-wrench"/>
                                    </div>
                                </div>
                                <div class="o_exec_subbadge o_subbadge_green d-flex align-items-center justify-content-between">
                                    <span><i class="fa fa-wrench me-1 text-success"/>Servicios Técnicos</span>
                                    <span class="fw-bold text-success"><t t-esc="state.data.mes_actual.pct_mo"/>% del mes</span>
                                </div>
                                <div class="o_exec_distribution_block mb-3">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="text-muted fw-semibold" style="font-size: 0.73rem;">Línea de Distribución</span>
                                        <span class="fw-bold" style="color: #059669; font-size: 0.75rem;"><t t-esc="state.data.mes_actual.pct_mo"/>%</span>
                                    </div>
                                    <div class="o_progress_track">
                                        <div class="o_progress_bar o_bar_mo" t-attf-style="width: #{state.data.mes_actual.pct_mo}%;"></div>
                                    </div>
                                </div>
                                <div class="d-flex align-items-center justify-content-between pt-2 border-top text-muted small mt-auto" style="font-size: 0.77rem;">
                                    <span><span class="o_status_dot o_status_green"></span> Operación:</span>
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">Taller Activo</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Tarjeta 3: Repuestos / Materiales del Mes -->
                    <div class="col-12 col-sm-6 col-xl">
                        <div class="card h-100 shadow-sm border-0 o_kpi_card o_kpi_orange cursor-pointer" t-on-click="openInvoicesMonth" title="Repuestos e insumos facturados">
                            <div class="card-body p-3 d-flex flex-column">
                                <div class="d-flex justify-content-between align-items-start mb-1">
                                    <div>
                                        <span class="o_kpi_title">Repuestos e Insumos</span>
                                        <div class="o_kpi_main_num" style="color: #d97706;"><t t-esc="state.data.mes_actual.rep_fmt"/></div>
                                    </div>
                                    <div class="o_kpi_icon_wrapper" style="background: #fffbeb; color: #d97706;">
                                        <i class="fa fa-cogs"/>
                                    </div>
                                </div>
                                <div class="o_exec_subbadge o_subbadge_amber d-flex align-items-center justify-content-between">
                                    <span><i class="fa fa-cogs me-1 text-warning"/>Partes y Materiales</span>
                                    <span class="fw-bold text-warning-emphasis"><t t-esc="state.data.mes_actual.pct_rep"/>% del mes</span>
                                </div>
                                <div class="o_exec_distribution_block mb-3">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="text-muted fw-semibold" style="font-size: 0.73rem;">Línea de Distribución</span>
                                        <span class="fw-bold" style="color: #d97706; font-size: 0.75rem;"><t t-esc="state.data.mes_actual.pct_rep"/>%</span>
                                    </div>
                                    <div class="o_progress_track">
                                        <div class="o_progress_bar o_bar_rep" t-attf-style="width: #{state.data.mes_actual.pct_rep}%;"></div>
                                    </div>
                                </div>
                                <div class="d-flex align-items-center justify-content-between pt-2 border-top text-muted small mt-auto" style="font-size: 0.77rem;">
                                    <span><span class="o_status_dot o_status_amber"></span> Consumo:</span>
                                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2 py-1">Rotación Stock</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Trabajos Externos del Mes -->
                    <div class="col-12 col-sm-6 col-xl">
                        <div class="card h-100 shadow-sm border-0 o_kpi_card o_kpi_blue cursor-pointer" t-on-click="openInvoicesMonth" title="Trabajos externos facturados">
                            <div class="card-body p-3 d-flex flex-column">
                                <div class="d-flex justify-content-between align-items-start mb-1">
                                    <div>
                                        <span class="o_kpi_title">Trabajos Externos (Mes)</span>
                                        <div class="o_kpi_main_num" style="color: #2563eb;"><t t-esc="state.data.mes_actual.ext_fmt"/></div>
                                    </div>
                                    <div class="o_kpi_icon_wrapper" style="background: #eff6ff; color: #2563eb;">
                                        <i class="fa fa-external-link"/>
                                    </div>
                                </div>
                                <div class="o_exec_subbadge d-flex align-items-center justify-content-between">
                                    <span><i class="fa fa-external-link me-1 text-primary"/>Servicios de Terceros</span>
                                    <span class="fw-bold text-primary"><t t-esc="state.data.mes_actual.pct_ext"/>% del mes</span>
                                </div>
                                <div class="o_exec_distribution_block mb-3">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="text-muted fw-semibold" style="font-size: 0.73rem;">Línea de Distribución</span>
                                        <span class="fw-bold" style="color: #2563eb; font-size: 0.75rem;"><t t-esc="state.data.mes_actual.pct_ext"/>%</span>
                                    </div>
                                    <div class="o_progress_track">
                                        <div class="o_progress_bar bg-primary" t-attf-style="width: #{state.data.mes_actual.pct_ext}%;"></div>
                                    </div>
                                </div>
                                <div class="d-flex align-items-center justify-content-between pt-2 border-top text-muted small mt-auto" style="font-size: 0.77rem;">
                                    <span><span class="o_status_dot "></span> Servicio:</span>
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">Trabajo Externo</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Tarjeta 4: Acumulado Anual y Flota -->
                    <div class="col-12 col-sm-6 col-xl">
                        <div class="card h-100 shadow-sm border-0 o_kpi_card o_kpi_purple">
                            <div class="card-body p-3 d-flex flex-column">
                                <div class="d-flex justify-content-between align-items-start mb-1">
                                    <div>
                                        <span class="o_kpi_title">Facturado Año <t t-esc="state.data.total_anual.anio"/></span>
                                        <div class="o_kpi_main_num"><t t-esc="state.data.total_anual.monto_fmt"/></div>
                                    </div>
                                    <div class="o_kpi_icon_wrapper" style="background: #f5f3ff; color: #7c3aed;">
                                        <i class="fa fa-calendar"/>
                                    </div>
                                </div>
                                <div class="o_exec_subbadge o_subbadge_purple d-flex align-items-center justify-content-between">
                                    <span><i class="fa fa-calculator me-1" style="color: #7c3aed;"/>Base Anual</span>
                                    <span>c/IVA: <strong class="text-dark"><t t-esc="state.data.total_anual.monto_con_iva_fmt"/></strong></span>
                                </div>
                                <div class="d-flex align-items-center gap-2 mb-3">
                                    <span class="badge px-2 py-1" style="background: #f5f3ff; color: #7c3aed; border: 1px solid #ddd6fe; font-size: 0.74rem;">
                                        <i class="fa fa-calendar-check-o me-1"/> Ejercicio <t t-esc="state.data.total_anual.anio"/>
                                    </span>
                                    <span class="text-muted small" style="font-size: 0.76rem;">Acumulado anual</span>
                                </div>
                                <div class="d-flex align-items-center justify-content-between pt-2 border-top text-muted small mt-auto" style="font-size: 0.77rem;">
                                    <span><i class="fa fa-car me-1" style="color: #7c3aed;"/> Flota Registrada:</span>
                                    <span class="badge bg-secondary-subtle text-secondary-emphasis border px-2 py-1 fw-bold"><t t-esc="state.data.flota.total_vehiculos"/> vehículos</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Fila 2: Donut Proporción MO vs Repuestos & Semáforo de Retención -->
                <div class="row g-3 mb-4">
                    <!-- Proporción Mano de Obra vs Repuestos -->
                    <div class="col-12 col-lg-5">
                        <div class="card h-100 shadow-sm border-0">
                            <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
                                <h5 class="card-title mb-0 fw-bold d-flex align-items-center">
                                    <i class="fa fa-pie-chart text-primary me-2"/> Distribución: Mano de Obra, Repuestos y Trabajos Externos
                                </h5>
                                <span class="badge bg-light text-muted border"><t t-esc="state.data.mes_actual.nombre"/></span>
                            </div>
                            <div class="card-body d-flex flex-column justify-content-center">
                                <div class="d-flex align-items-center justify-content-around py-3">
                                    <!-- Donut Chart Visual SVG -->
                                    <div class="o_donut_wrapper position-relative text-center">
                                        <svg viewBox="0 0 36 36" class="o_donut_svg" style="width: 140px; height: 140px;">
                                            <path class="o_donut_bg" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" fill="none" stroke="#f1f5f9" stroke-width="4.5"/>
                                            <!-- Arco Repuestos (Naranja/Warning) -->
                                            <path class="o_donut_segment_rep" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" fill="none" stroke="#f59e0b" stroke-width="4.5" t-attf-stroke-dasharray="#{state.data.mes_actual.pct_rep}, 100" t-att-stroke-dashoffset="-state.data.mes_actual.pct_mo"/>
                                            <!-- Arco Mano de Obra (Verde) -->
                                            <path class="o_donut_segment_mo" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" fill="none" stroke="#10b981" stroke-width="4.5" t-attf-stroke-dasharray="#{state.data.mes_actual.pct_mo}, 100"/>
                                            <path d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" fill="none" stroke="#2563eb" stroke-width="4.5" t-attf-stroke-dasharray="#{state.data.mes_actual.pct_ext}, 100" t-att-stroke-dashoffset="-(state.data.mes_actual.pct_mo + state.data.mes_actual.pct_rep)"/>
                                        </svg>
                                        <div class="o_donut_center text-center">
                                            <span class="text-muted d-block" style="font-size: 0.75rem;">M/O</span>
                                            <strong class="text-success h5 mb-0"><t t-esc="state.data.mes_actual.pct_mo"/>%</strong>
                                        </div>
                                    </div>

                                    <!-- Leyenda con Valores -->
                                    <div class="o_donut_legend ps-3">
                                        <div class="mb-3">
                                            <div class="d-flex align-items-center mb-1">
                                                <span class="o_legend_bullet bg-success me-2"/>
                                                <span class="fw-semibold">Mano de Obra</span>
                                            </div>
                                            <h5 class="mb-0 text-success fw-bold ps-3"><t t-esc="state.data.mes_actual.mo_fmt"/></h5>
                                            <small class="text-muted ps-3"><t t-esc="state.data.mes_actual.pct_mo"/>% de la distribución</small>
                                        </div>
                                        <div>
                                            <div class="d-flex align-items-center mb-1">
                                                <span class="o_legend_bullet bg-warning me-2"/>
                                                <span class="fw-semibold">Repuestos e Insumos</span>
                                            </div>
                                            <h5 class="mb-0 text-dark fw-bold ps-3"><t t-esc="state.data.mes_actual.rep_fmt"/></h5>
                                            <small class="text-muted ps-3"><t t-esc="state.data.mes_actual.pct_rep"/>% de la distribución</small>
                                        </div>
                                        <div class="mt-3">
                                            <div class="d-flex align-items-center mb-1">
                                                <span class="o_legend_bullet bg-primary me-2"/>
                                                <span class="fw-semibold">Trabajos Externos</span>
                                            </div>
                                            <h5 class="mb-0 text-primary fw-bold ps-3"><t t-esc="state.data.mes_actual.ext_fmt"/></h5>
                                            <small class="text-muted ps-3"><t t-esc="state.data.mes_actual.pct_ext"/>% de la distribución</small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Semáforo de Retención de Flota -->
                    <div class="col-12 col-lg-7">
                        <div class="card h-100 shadow-sm border-0">
                            <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
                                <h5 class="card-title mb-0 fw-bold d-flex align-items-center">
                                    <i class="fa fa-heartbeat text-danger me-2"/> Retención de Vehículos y Salud de Flota
                                </h5>
                                <button class="btn btn-sm btn-outline-primary" t-on-click="() => this.openAllVehicles()">
                                    Ver Todos (<t t-esc="state.data.flota.total_vehiculos"/>)
                                </button>
                            </div>
                            <div class="card-body">
                                <p class="text-muted small mb-3">Segmentación basada en la fecha del último servicio registrado en taller:</p>
                                
                                <div class="row g-3 text-center">
                                    <div class="col-4">
                                        <div class="p-3 rounded bg-success-subtle border border-success-subtle cursor-pointer h-100" t-on-click="() => this.openAllVehicles('search_default_filter_active')" title="Clic para ver vehículos activos">
                                            <div class="text-success fw-bold mb-1" style="font-size: 0.85rem;">
                                                <i class="fa fa-check-circle me-1"/> Activos
                                            </div>
                                            <h2 class="fw-bold text-success mb-0"><t t-esc="state.data.flota.activos"/></h2>
                                            <small class="text-muted">≤ 30 días</small>
                                        </div>
                                    </div>

                                    <div class="col-4">
                                        <div class="p-3 rounded bg-warning-subtle border border-warning-subtle cursor-pointer h-100" t-on-click="() => this.openAllVehicles('search_default_filter_semi_active')" title="Clic para ver vehículos en alerta">
                                            <div class="text-warning-emphasis fw-bold mb-1" style="font-size: 0.85rem;">
                                                <i class="fa fa-clock-o me-1"/> En Alerta
                                            </div>
                                            <h2 class="fw-bold text-warning-emphasis mb-0"><t t-esc="state.data.flota.alerta"/></h2>
                                            <small class="text-muted">31 - 90 días</small>
                                        </div>
                                    </div>

                                    <div class="col-4">
                                        <div class="p-3 rounded bg-danger-subtle border border-danger-subtle cursor-pointer h-100" t-on-click="() => this.openAllVehicles('search_default_filter_inactive')" title="Clic para ver vehículos en riesgo de fuga">
                                            <div class="text-danger fw-bold mb-1" style="font-size: 0.85rem;">
                                                <i class="fa fa-exclamation-triangle me-1"/> En Riesgo
                                            </div>
                                            <h2 class="fw-bold text-danger mb-0"><t t-esc="state.data.flota.riesgo"/></h2>
                                            <small class="text-muted">&gt; 90 días</small>
                                        </div>
                                    </div>
                                </div>

                                <div class="alert alert-warning mt-3 mb-0 py-2 px-3 small d-flex align-items-center" role="alert">
                                    <i class="fa fa-info-circle fa-lg me-2 text-warning"/>
                                    <span>Hay <strong><t t-esc="state.data.flota.riesgo"/> vehículos</strong> sin visitar el taller en más de 3 meses. Una campaña de recordatorio por WhatsApp puede recuperar hasta un 30% de visitas.</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Fila 3: Top 5 Clientes y Flotas & Top Mecánicos Productivos -->
                <div class="row g-3 mb-4">
                    <!-- Top 5 Clientes y Flotas -->
                    <div class="col-12 col-lg-6">
                        <div class="card h-100 shadow-sm border-0">
                            <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
                                <h5 class="card-title mb-0 fw-bold d-flex align-items-center">
                                    <i class="fa fa-users text-primary me-2"/> Top 5 Clientes y Flotas con Mayor Gasto
                                </h5>
                                <span class="text-muted small">Histórico Taller</span>
                            </div>
                            <div class="card-body p-0">
                                <div class="table-responsive">
                                    <table class="table table-hover align-middle mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th style="width: 40px;">#</th>
                                                <th>Cliente / Flota</th>
                                                <th class="text-center">Autos</th>
                                                <th class="text-center">Facturas</th>
                                                <th class="text-end">Total Facturado</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="state.data.top_clientes" t-as="cliente" t-key="cliente.id">
                                                <tr class="cursor-pointer" t-on-click="() => this.openPartner(cliente.id)" title="Ver ficha del cliente">
                                                    <td>
                                                        <span class="badge rounded-circle bg-light text-dark border"><t t-esc="cliente_index + 1"/></span>
                                                    </td>
                                                    <td>
                                                        <strong class="text-primary"><t t-esc="cliente.name"/></strong>
                                                    </td>
                                                    <td class="text-center">
                                                        <span class="badge bg-secondary-subtle text-dark"><i class="fa fa-car me-1"/> <t t-esc="cliente.cant_vehiculos"/></span>
                                                    </td>
                                                    <td class="text-center">
                                                        <span class="badge bg-light text-muted border"><t t-esc="cliente.cant_facturas"/></span>
                                                    </td>
                                                    <td class="text-end fw-bold text-dark">
                                                        <t t-esc="cliente.total_fmt"/>
                                                    </td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Top Mecánicos Productivos -->
                    <div class="col-12 col-lg-6">
                        <div class="card h-100 shadow-sm border-0">
                            <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
                                <h5 class="card-title mb-0 fw-bold d-flex align-items-center">
                                    <i class="fa fa-wrench text-warning me-2"/> Top Mecánicos Más Productivos
                                </h5>
                                <span class="text-muted small">Por Mano de Obra Facturada</span>
                            </div>
                            <div class="card-body p-0">
                                <div class="table-responsive">
                                    <table class="table table-hover align-middle mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th style="width: 40px;">#</th>
                                                <th>Mecánico</th>
                                                <th class="text-center">Servicios</th>
                                                <th class="text-end">Mano de Obra Facturada</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="state.data.top_mecanicos" t-as="mecanico" t-key="mecanico.id">
                                                <tr>
                                                    <td>
                                                        <t t-if="mecanico_index == 0">🥇</t>
                                                        <t t-elif="mecanico_index == 1">🥈</t>
                                                        <t t-elif="mecanico_index == 2">🥉</t>
                                                        <t t-else="">
                                                            <span class="badge rounded-circle bg-light text-dark border"><t t-esc="mecanico_index + 1"/></span>
                                                        </t>
                                                    </td>
                                                    <td>
                                                        <strong class="text-dark"><t t-esc="mecanico.name"/></strong>
                                                    </td>
                                                    <td class="text-center">
                                                        <span class="badge bg-light text-dark border"><i class="fa fa-check me-1 text-success"/> <t t-esc="mecanico.cant_servicios"/></span>
                                                    </td>
                                                    <td class="text-end fw-bold text-success">
                                                        <t t-esc="mecanico.total_mo_fmt"/>
                                                    </td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Fila 4: Alerta de Vehículos en Riesgo de Fuga (> 90 días) -->
                <div class="card shadow-sm border-0 border-top border-4 border-danger mb-4">
                    <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="card-title mb-0 fw-bold text-danger d-flex align-items-center">
                                <i class="fa fa-exclamation-triangle me-2"/> Vehículos en Riesgo de Fuga (&gt; 90 Días sin Servicio)
                            </h5>
                            <p class="text-muted small mb-0">Vehículos de alto valor histórico que no han visitado el taller recientemente</p>
                        </div>
                        <button class="btn btn-sm btn-outline-danger" t-on-click="openVehiclesRisk">
                            Ver Todos los Vehículos en Riesgo
                        </button>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Placa</th>
                                        <th>Propietario / Cliente</th>
                                        <th>Marca / Modelo</th>
                                        <th>Última Visita</th>
                                        <th class="text-center">Inactividad</th>
                                        <th class="text-end">Histórico Facturado</th>
                                        <th class="text-center">Acción</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="state.data.vehiculos_riesgo" t-as="veh" t-key="veh.placa">
                                        <tr>
                                            <td>
                                                <span class="badge bg-dark font-monospace px-2 py-1"><t t-esc="veh.placa"/></span>
                                            </td>
                                            <td>
                                                <strong class="text-primary cursor-pointer" t-on-click="() => this.openPartner(veh.partner_id)">
                                                    <t t-esc="veh.partner_name"/>
                                                </strong>
                                            </td>
                                            <td>
                                                <t t-esc="veh.marca"/> <t t-esc="veh.modelo"/>
                                            </td>
                                            <td>
                                                <span class="text-muted"><t t-esc="veh.fecha_ultimo_servicio_fmt"/></span>
                                            </td>
                                            <td class="text-center">
                                                <span class="badge bg-danger rounded-pill px-2 py-1">
                                                    <i class="fa fa-warning me-1"/> <t t-esc="veh.dias_sin_servicio"/> días
                                                </span>
                                            </td>
                                            <td class="text-end fw-bold text-dark">
                                                <t t-esc="veh.total_facturado_fmt"/>
                                            </td>
                                            <td class="text-center">
                                                <button class="btn btn-sm btn-outline-primary py-0 px-2" t-on-click="() => this.openVehicleDetail(veh.placa)" title="Ver Historial">
                                                    <i class="fa fa-history me-1"/> Ver
                                                </button>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Fila 4: Histórico Comparativo de Facturación (Últimos 12 Meses) -->
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-white py-3 d-flex flex-wrap justify-content-between align-items-center border-bottom gap-2">
                        <div>
                            <h5 class="card-title fw-bold text-dark mb-0 d-flex align-items-center">
                                <i class="fa fa-history text-primary me-2"/> Evolución Histórica de Ventas del Taller (Últimos 12 Meses)
                            </h5>
                            <p class="text-muted small mb-0">Haga clic en cualquier fila o en "Ver Mes" para cargar instantáneamente todos los KPIs y análisis de ese período</p>
                        </div>
                        <span class="badge bg-primary-subtle text-primary fw-semibold px-3 py-2">
                            <i class="fa fa-check-circle me-1"/> Filtro estricto Taller Grupo 2
                        </span>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Mes / Período</th>
                                        <th class="text-center">Facturas</th>
                                        <th class="text-end">Mano de Obra</th>
                                        <th class="text-end">Repuestos / Insumos</th>
                                        <th class="text-end">Trabajos Externos</th>
                                        <th class="text-center">% Mano de Obra</th>
                                        <th class="text-end">Subtotal (Sin IVA)</th>
                                        <th class="text-end">Total c/IVA</th>
                                        <th class="text-center">Acción</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="state.data.historico_mensual" t-as="h" t-key="h.key">
                                        <tr t-att-class="h.is_selected ? 'table-primary fw-bold' : ''" style="cursor: pointer;" t-on-click="() => this.selectPeriod(h.year, h.month)">
                                            <td>
                                                <i t-if="h.is_selected" class="fa fa-chevron-circle-right text-primary me-2"/>
                                                <span t-att-class="h.is_selected ? 'text-primary' : 'text-dark'"><t t-esc="h.nombre"/></span>
                                                <span t-if="h.is_selected" class="badge bg-primary text-white ms-2" style="font-size: 0.7rem;">Seleccionado</span>
                                            </td>
                                            <td class="text-center">
                                                <span class="badge rounded-pill bg-light text-dark border px-2 py-1"><t t-esc="h.facturas"/> facturas</span>
                                            </td>
                                            <td class="text-end text-primary">
                                                <t t-esc="h.mo_fmt"/>
                                            </td>
                                            <td class="text-end text-success">
                                                <t t-esc="h.rep_fmt"/>
                                            </td>
                                            <td class="text-end text-primary"><t t-esc="h.ext_fmt"/></td>
                                            <td class="text-center">
                                                <div class="d-flex align-items-center justify-content-center gap-1">
                                                    <div class="progress flex-grow-1" style="height: 6px; max-width: 80px;">
                                                        <div class="progress-bar bg-primary" role="progressbar" t-attf-style="width: #{h.pct_mo}%;"/>
                                                    </div>
                                                    <span class="small text-muted"><t t-esc="h.pct_mo"/>%</span>
                                                </div>
                                            </td>
                                            <td class="text-end fw-bold fs-6 text-dark">
                                                <t t-esc="h.subtotal_fmt"/>
                                            </td>
                                            <td class="text-end text-muted small">
                                                <t t-esc="h.total_fmt"/>
                                            </td>
                                            <td class="text-center" t-on-click.stop="">
                                                <button t-if="!h.is_selected" class="btn btn-sm btn-outline-primary py-0 px-2" t-on-click="() => this.selectPeriod(h.year, h.month)">
                                                    <i class="fa fa-folder-open-o me-1"/> Ver Mes
                                                </button>
                                                <span t-else="" class="text-success small fw-bold">
                                                    <i class="fa fa-check"/> Activo
                                                </span>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </t>
        </div>
    </t>
</templates>

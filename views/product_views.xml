<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_form_inherit_analitica_taller" model="ir.ui.view">
        <field name="name">product.template.form.inherit.analitica.taller</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='categ_id']" position="after">
                <field name="es_mano_de_obra" widget="boolean_toggle" string="Es Mano de Obra / Servicio"/>
            </xpath>
        </field>
    </record>

    <record id="view_product_product_form_inherit_analitica_taller" model="ir.ui.view">
        <field name="name">product.product.form.inherit.analitica.taller</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='categ_id']" position="after">
                <field name="es_mano_de_obra" widget="boolean_toggle" string="Es Mano de Obra / Servicio"/>
            </xpath>
        </field>
    </record>
</odoo>
